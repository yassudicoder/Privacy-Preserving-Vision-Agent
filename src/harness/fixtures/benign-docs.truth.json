{
  "schemaVersion": 1,
  "id": "benign-docs",
  "description": "Zero PII. The false-positive canary: any detection here is a precision failure, and precision is 20% of the score. If this fixture ever produces a redaction, a rule got too greedy.",
  "viewport": { "cssWidth": 1280, "cssHeight": 800, "scrollX": 0, "scrollY": 0, "devicePixelRatio": 1 },
  "sensitive": [],
  "benign": [
    { "selector": "h1", "note": "heading" },
    { "selector": "h2", "note": "heading" },
    { "selector": "#q", "note": "search box; 'Search' must not trip a PII keyword rule" },
    { "selector": "button[type=submit]", "note": "action" },
    { "selector": "a[href='/handbook/telemetry']", "note": "navigation" }
  ],
  "expectedElements": [
    { "id": "h1", "role": "heading", "name": "Ground station handbook", "selector": "h1", "sensitive": false, "rect": { "x": 60, "y": 40, "width": 700, "height": 40 } },
    { "id": "search", "role": "searchbox", "name": "Search documentation", "selector": "#q", "sensitive": false, "rect": { "x": 60, "y": 180, "width": 420, "height": 40 } },
    { "id": "search-btn", "role": "button", "name": "Search", "selector": "button[type=submit]", "sensitive": false, "rect": { "x": 500, "y": 180, "width": 120, "height": 40 } },
    { "id": "h2", "role": "heading", "name": "Antenna pointing", "selector": "h2", "sensitive": false, "rect": { "x": 60, "y": 250, "width": 700, "height": 30 } },
    { "id": "telemetry-link", "role": "link", "name": "Telemetry chapter", "selector": "a[href='/handbook/telemetry']", "sensitive": false, "rect": { "x": 60, "y": 370, "width": 200, "height": 20 } }
  ]
}
