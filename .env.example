# Copy to `.env`. That file is gitignored; this one is the documentation.
#
# WHO READS THIS FILE. Two different things, and they read it two different ways:
#
#   scripts/build.mjs   reads AGENT_ORIGIN only, with its own parser, at BUILD
#                       time - so the extension bundle remembers a server origin
#                       across shells and reboots.
#   npm run server      reads all of it, via `tsx --env-file-if-exists=.env`.
#
# In both cases a variable exported in your SHELL WINS over the value here, so a
# one-off override stays a one-off override.
#
# `npm start` deliberately does NOT read this file. That is the Render entry
# point, where configuration comes from the dashboard and a `.env` in the image
# would be a credential in the image.


# ---------------------------------------------------------------------------
# Local model: Ollama on this machine
# ---------------------------------------------------------------------------
#
# The full recipe, and the two lines that are not obvious are both here.
#
#   ollama pull qwen2.5vl:3b
#   ollama create qwen2.5vl-8k -f Modelfile
#
# where Modelfile is two lines - `FROM qwen2.5vl:3b` and
# `PARAMETER num_ctx 8192`. It must be a real file: `-f -` on stdin is
# refused with "no Modelfile or safetensors files found".
#
# WHY A CUSTOM MODEL RATHER THAN STOCK `qwen2.5vl:3b`. Ollama serves a model at
# the `num_ctx` its Modelfile pins, and stock qwen2.5vl pins none - so it runs at
# Ollama's default, which is 4096. The extension budgets its prompt to 30,000
# tokens by default. Ollama does not REFUSE an over-long prompt; it truncates it
# and the model answers anyway, and what gets cut is the end of the prompt -
# where this project deliberately puts the element list and the correction block.
#
# Measured, same page and goal, differing only in the client's budget:
#
#   30,000-token budget -> {"type":"done","summary":"..."}          gives up
#    5,000-token budget -> {"type":"type","ref":"e21","text":"privacy"}   correct
#
# You do not have to set the panel's prompt-budget field to match: pinning
# num_ctx is what makes the window KNOWABLE, the server reports it on /health as
# `vlm.contextWindow`, and the extension clamps its own budget to it. A model
# pinning nothing reports null and gets no clamp, which is the case this whole
# paragraph exists to avoid. `npm run verify:server` prints what was found.
#
VLM_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
VLM_MODEL=qwen2.5vl-8k:latest

# How hard the model may think. `off` OMITS the parameter entirely, which is
# different from the value `none` and is what an endpoint that rejects the field
# outright needs.
#
# Leave it unset and the server sends `low`, which is right for a cloud
# reasoning model and which Ollama REFUSES for a non-thinking model with
# `400 "does not support thinking"`. The server notices that specific refusal and
# retries once without the field, so an unset value works - this just skips the
# wasted round trip.
VLM_REASONING=off

# Bounds reasoning PLUS answer, not just the answer. 160 was once the default and
# it truncated a correct action mid-string on a real run.
# VLM_MAX_TOKENS=2048

# How long Ollama keeps the model loaded after each plan. Ollama's own default
# is 5 minutes, so the first plan after a pause pays a model load (8.2 s on a
# real run). The server preloads at startup and re-asks after every plan.
# `off` or `0` disables it; the cost is the model's VRAM, held for the window.
# VLM_KEEP_ALIVE=30m

# Append every plan IN FULL (rendered prompt, raw reply, timings) as JSON lines
# under this directory. The prompt is already sanitized, but it is still a
# record of which pages were visited - leave it unset on anything hosted.
# AGENT_TRACE_DIR=./traces


# ---------------------------------------------------------------------------
# Hosted model providers - pick ONE, or none
# ---------------------------------------------------------------------------
#
# An explicit VLM_ENDPOINT above beats both of these. Gemini is checked before
# OpenAI when both are set.
#
# GEMINI_API_KEY=            # or GOOGLE_API_KEY - both are accepted
# OPENAI_API_KEY=


# ---------------------------------------------------------------------------
# The two secrets that travel in OPPOSITE directions
# ---------------------------------------------------------------------------
#
# OPENAI_API_KEY / GEMINI_API_KEY is what the SERVER presents to the model
# provider. AGENT_AUTH_TOKEN is what the server REQUIRES from the extension.
# Conflating them hands the provider's key to every browser that connects.
#
# Unset is the right default for loopback: the server holds no data, and a token
# in a development script is a credential in a development script. Set it for any
# deployment more than one machine can route to.
#
# AGENT_AUTH_TOKEN=


# ---------------------------------------------------------------------------
# Extension build
# ---------------------------------------------------------------------------
#
# BUILD-time only, read by scripts/build.mjs. Set, it bakes this origin into the
# bundle and declares one `host_permissions` entry for it, so a distribution
# build opens already pointing at a server with nothing to type. Unset, the build
# configures nothing and the extension defaults to on-device.
#
# Must be https, no wildcard, a real hostname - anything else yields NO host
# permission rather than a broad one.
#
# AGENT_ORIGIN=https://your-service.onrender.com
